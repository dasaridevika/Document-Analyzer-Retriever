# Cloudflare Workers AI Credentials (Optional - if omitted, local embedding/llm fallback will be used)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Models
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
CLOUDFLARE_LLM_MODEL=@cf/zai-org/glm-4.7-flash

# Local OpenAI-Compatible LLM Settings (e.g. LM Studio, Ollama)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# OpenAI API Settings (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage Settings (Maps to /data on Railway Volume)
DATA_DIR=./storage

# App Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
