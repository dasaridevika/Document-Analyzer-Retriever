# Cloudflare Workers AI Credentials (Optional - if omitted, local embedding/llm fallback will be used)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Models
# Options: @cf/baai/bge-large-en-v1.5 or @cf/google/embeddinggemma-300m
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-large-en-v1.5
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3-8b-instruct

# Storage Settings (Maps to /data on Railway Volume)
DATA_DIR=./storage

# App Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
